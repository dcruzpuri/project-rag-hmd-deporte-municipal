#  Hacer una copia del archivo a .env -----------------

#  Proveedores de embeddings y de generación ---
# "ollama" (offline, sin coste) | "huggingface" | "google"
EMBED_PROVIDER="huggingface"
TAG_PROVIDER="huggingface"
GEN_PROVIDER="huggingface"

#  Ollama (offline) -----------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBED_MODEL="qwen3-embedding:4b"
OLLAMA_TAG_MODEL="llama3.2"
OLLAMA_GEN_MODEL="llama3.2"

#  HuggingFace (online) -------------------------------
HF_EMBED_MODEL="Qwen/Qwen3-Embedding-0.6B"
HF_GEN_MODEL="meta-llama/Llama-3.2-3B-Instruct"
# "cpu" | "cuda" → carga los modelos (embeddings y/o generación) en CPU o GPU 
# de modo que la inferencia se ejecuta en ese recurso. NOTA: "cuda" requiere GPU de NVIDIA con drivers instalados.
HF_DEVICE="cuda"  
# Solo si el modelo es gated (dejar vacío)
HF_TOKEN=

#  Google (online) ------------------------------------
GOOGLE_API_KEY=
GOOGLE_EMBED_MODEL="gemini-embedding-2"
GOOGLE_GEN_MODEL="gemini-2.0-flash"

#  Chunking 
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

#  Retrieval 

#  Embeddings
# Cap de dimensión del índice: dim final = min(dim del modelo, EMBED_DIM).
# Si el modelo produce más, se recorta y renormaliza (Ollama/HF lo respetan
# en servidor; siempre hay recorte cliente de garantía).
EMBED_DIM=1024
EMBED_BATCH_SIZE=100
EXPORT_EMBEDDINGS=true
# Dim máxima que maneja el modelo (la expone el preflight). Alimenta el caché
# offline (red cortada / sin API key) y el mensaje INFO de EMBED_DIM < dim modelo.
# Vacío = no declarado.
EMBED_DIM_MAX_OLLAMA=
EMBED_DIM_MAX_HF=1024
EMBED_DIM_MAX_GOOGLE=

#  TSD (tag + scoring + dedup) 
TAG_SCORING_DEDUP=false
DEDUP_UMBRAL=0.93

#  ChromaDB 
CHROMA_DIR="./output/chroma"
COLLECTION_NAME="deporte_municipal"
GEMINI_API_KEY=
