#  Hacer una copia del archivo a .env -----------------
#
#  Proveedores de embeddings y de generación ---
# "ollama" (offline, sin coste) | "huggingface" | "google"
EMBED_PROVIDER="ollama"
TAG_PROVIDER="ollama"
GEN_PROVIDER="ollama"

#  Ollama (offline) -----------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_EMBED_MODEL="sentence-transformers/all-MiniLM-L6-v2"
OLLAMA_TAG_MODEL="llama3.2"
OLLAMA_GEN_MODEL="llama3.2"

#  HuggingFace (online) -------------------------------
HF_EMBED_MODEL="Qwen/Qwen3-Embedding-4B"
HF_TAG_MODEL="meta-llama/Llama-3.2-3B-Instruct"
HF_GEN_MODEL="meta-llama/Llama-3.2-3B-Instruct"
# "cpu" | "cuda" → carga los modelos (embeddings y/o generación) en CPU o GPU de modo que la inferencia se ejecuta en ese recurso. NOTA: "cuda" requiere GPU de NVIDIA con drivers instalados.
HF_DEVICE="cuda"  
# Dejar vacío solo si el modelo es gated 
HF_TOKEN=""

#  Google (online) ------------------------------------
GOOGLE_API_KEY=
GOOGLE_EMBED_MODEL="gemini-embedding-2"
GOOGLE_TAG_MODEL="gemini-3.6-flash"
GOOGLE_GEN_MODEL="gemini-3.6-flash"

#  Chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# --- Retrieval ---
TOP_K=5
MAX_CHUNKS=5

#  Embeddings
# Cap de dimensión del índice: dim final = min(dim del modelo, EMBED_DIM).
# Si el modelo produce más, se recorta y renormaliza (Ollama/HF lo respetan
# en servidor; siempre hay recorte cliente de garantía).
EMBED_DIM=384
EMBED_BATCH_SIZE=30
EXPORT_EMBEDDINGS=true
# Dimensión nativa máxima del modelo de embeddings. La comprobación online
# (PREFLIGHT) solo verifica la disponibilidad, nunca la dimensión: por eso se
# declara aquí. Alimenta el caché offline (red cortada / sin API key) y los
# mensajes de dimensiones (INFO si EMBED_DIM < dim modelo; AVISO si EMBED_DIM
# supera la dimensión generada). Vacío = no declarada (la fila EMBED_DIM_MODELO
# del informe lo indica). Ej.: 384 (all-MiniLM-L6-v2) · 2560 (qwen3-embedding:4b)
# Vacío = no declarado.
EMBED_DIM_MAX_OLLAMA=
EMBED_DIM_MAX_HF=
EMBED_DIM_MAX_GOOGLE=

#  TSD (tag + scoring + dedup)
TAG_SCORING_DEDUP=true
DEDUP_UMBRAL=0.93
# Auditoría de pares descartados: una línea JSON por descarte (coseno/clave,
# similitud, chunk afectado y vencedor). Vacío (false) = sin auditoría.
DEDUP_AUDIT=true
DEDUP_AUDIT_RUTA="output/dedup_audit.jsonl"

# Eval set (offline, durante el indexado)
# Genera queries/eval_set.jsonl con el interruptor GEN (despues de dedup).
# Cada consulta fallida se omite sin detener el indexado.
EVAL_SET=true
EVAL_SET_N=50
EVAL_SET_RUTA="queries/eval_set.jsonl"
# Timeout por llamada al chat de Ollama (GEN)
GEN_TIMEOUT=240

#  ChromaDB
CHROMA_DIR="./output/chroma_db"
COLLECTION_NAME="deporte_municipal"
# Después del indexado generará un set de preguntas por cada texto de
# output/embeddings.json: una pregunta por línea en JSONL (pregunta,
# respuesta_posible y source/file_hash/doc_category desde metadata).
# Se activa si QUESTION_SET=true y usa MAX_QUESTIONS (1..MAX_QUESTIONS)
# preguntas por texto.
QUESTION_SET=true
MAX_QUESTIONS=2
QUESTION_SET_RUTA="./output/question_set.jsonl"